  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-local"
    },
    "final": "漏网之鱼",
    "rule_set": [
      {
        "download_detour": "direct",
        "format": "source",
        "tag": "ads",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/slynnnn/surge-rules/main/platforms/singbox/merged/ads.json"
      },
      {
        "download_detour": "direct",
        "format": "source",
        "tag": "ai",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/slynnnn/surge-rules/main/platforms/singbox/merged/ai.json"
      },
      {
        "download_detour": "direct",
        "format": "source",
        "tag": "streaming",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/slynnnn/surge-rules/main/platforms/singbox/merged/streaming.json"
      },
      {
        "download_detour": "direct",
        "format": "source",
        "tag": "social",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/slynnnn/surge-rules/main/platforms/singbox/merged/social.json"
      },
      {
        "download_detour": "direct",
        "format": "source",
        "tag": "global",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/slynnnn/surge-rules/main/platforms/singbox/merged/global.json"
      },
      {
        "download_detour": "direct",
        "format": "source",
        "tag": "china",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/slynnnn/surge-rules/main/platforms/singbox/merged/china.json"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "reject",
        "rule_set": [
          "ads"
        ]
      },
      {
        "outbound": "AI",
        "rule_set": [
          "ai"
        ]
      },
      {
        "outbound": "流媒体",
        "rule_set": [
          "streaming"
        ]
      },
      {
        "outbound": "社交",
        "rule_set": [
          "social"
        ]
      },
      {
        "outbound": "节点选择",
        "rule_set": [
          "global"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "china"
        ]
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ]
  }
}
