{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "action": "route",
        "domain": [
          "raw.githubusercontent.com"
        ],
        "server": "dns-local"
      },
      {
        "action": "route",
        "rule_set": [
          "china"
        ],
        "server": "dns-local"
      }
    ],
    "servers": [
      {
        "detour": "节点选择",
        "server": "1.1.1.1",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "server": "223.5.5.5",
        "tag": "dns-local",
        "type": "https"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db"
    },
    "clash_api": {
      "default_mode": "rule",
      "external_controller": "127.0.0.1:9090"
    }
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "info",
    "timestamp": true
  },
  "outbounds": [
